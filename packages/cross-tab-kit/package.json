{
  "name": "cross-tab-kit",
  "version": "0.4.0",
  "description": "Framework-agnostic cross-tab coordination for the browser: a Web Locks mutex (waiting and skip-if-busy), timer-driven or caller-driven leader election, and a TTL dedupe cache.",
  "keywords": [
    "cross-tab",
    "dedupe",
    "leader-election",
    "localstorage",
    "mutex",
    "web-locks"
  ],
  "homepage": "https://github.com/ueaner/web-kits/tree/main/packages/cross-tab-kit#readme",
  "bugs": {
    "url": "https://github.com/ueaner/web-kits/issues"
  },
  "license": "MIT",
  "author": "ueaner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueaner/web-kits.git",
    "directory": "packages/cross-tab-kit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "default": "./dist/advanced.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test tsdown.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "pub:check": "publint",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run pub:check"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.5.2"
}
