{
  "name": "cross-tab-kit",
  "version": "0.1.0",
  "description": "Framework-agnostic cross-tab coordination primitives for the browser: a Web Locks mutex, a renewable poll-leader lease, a TTL dedupe cache, and safe localStorage helpers.",
  "keywords": [
    "cross-tab",
    "dedupe",
    "leader-election",
    "localstorage",
    "mutex",
    "web-locks"
  ],
  "homepage": "https://github.com/ueaner/cross-tab-kit#readme",
  "bugs": {
    "url": "https://github.com/ueaner/cross-tab-kit/issues"
  },
  "license": "MIT",
  "author": "ueaner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueaner/cross-tab-kit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test tsdown.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "pub:check": "publint",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run pub:check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.5.2"
}
