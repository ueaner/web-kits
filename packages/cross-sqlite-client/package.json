{
  "name": "cross-sqlite-client",
  "version": "0.2.1",
  "description": "Cross-platform (Web + Tauri) SQLite client with a shared migration framework and React bindings.",
  "keywords": [
    "migration",
    "opfs",
    "react",
    "sqlite",
    "sqlite-wasm",
    "tauri"
  ],
  "homepage": "https://github.com/ueaner/web-kits/tree/main/packages/cross-sqlite-client#readme",
  "bugs": {
    "url": "https://github.com/ueaner/web-kits/issues"
  },
  "license": "MIT",
  "author": "ueaner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueaner/web-kits.git",
    "directory": "packages/cross-sqlite-client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./adapters/web": {
      "types": "./dist/adapters/web.d.ts",
      "import": "./dist/adapters/web.js"
    },
    "./adapters/tauri": {
      "types": "./dist/adapters/tauri.d.ts",
      "import": "./dist/adapters/tauri.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "pub:check": "publint",
    "changeset": "changeset",
    "prepublishOnly": "npm run build && npm run pub:check && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tauri-apps/plugin-sql": "^2.4.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.2"
}
