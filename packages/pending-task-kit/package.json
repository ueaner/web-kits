{
  "name": "pending-task-kit",
  "version": "0.5.0",
  "description": "Framework-agnostic background task polling/notification engine, with an optional React binding.",
  "keywords": [
    "background-task",
    "cross-tab",
    "localstorage",
    "polling",
    "react",
    "zustand"
  ],
  "homepage": "https://github.com/ueaner/web-kits/tree/main/packages/pending-task-kit#readme",
  "bugs": {
    "url": "https://github.com/ueaner/web-kits/issues"
  },
  "license": "MIT",
  "author": "ueaner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueaner/web-kits.git",
    "directory": "packages/pending-task-kit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test-e2e",
    "lint": "oxlint src test test-e2e playwright.config.ts tsdown.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "pub:check": "publint",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run pub:check"
  },
  "dependencies": {
    "cross-tab-kit": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.2"
}
