{
  "name": "pending-task-kit",
  "version": "0.2.0",
  "description": "Framework-agnostic background task polling/notification engine, with an optional React binding.",
  "license": "MIT",
  "author": "ueaner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueaner/pending-task-kit.git"
  },
  "homepage": "https://github.com/ueaner/pending-task-kit#readme",
  "bugs": {
    "url": "https://github.com/ueaner/pending-task-kit/issues"
  },
  "keywords": [
    "polling",
    "background-task",
    "cross-tab",
    "zustand",
    "react",
    "localstorage"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.5.2",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test-e2e",
    "lint": "oxlint src test test-e2e playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "pub:check": "publint",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build && npm run pub:check"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.7",
    "jsdom": "^25.0.1",
    "oxlint": "^1.83.0",
    "publint": "^0.3.24",
    "react": "^19.2.7",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^3.0.5",
    "zustand": "^5.0.14"
  }
}
